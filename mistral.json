{
  "schemaVersion": 2,
  "kind": "app",
  "name": "app",
  "deployment": {
    "organizationId": "f1392492-b321-42f5-aa91-dd2d99d8ccdd",
    "workspaceId": "cfb97f88-0fca-4e00-932b-23cf20323323",
    "appId": "01a1cb0a-dd36-77b0-8dff-d25b071c70ba"
  },
  "modules": [
    {
      "type": "app",
      "name": "api",
      "path": "apps/api",
      "routes": [
        {
          "path": "/api"
        }
      ],
      "port": 3000,
      "serve": "server",
      "runtime": "python",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.api",
        "target": "api"
      },
      "dev": {
        "startCommand": "uv run --all-packages python -m api.dev",
        "preStartCommands": [
          "uv run --all-packages python -m cli pre-start"
        ]
      },
      "deploy": {
        "startCommand": "uv run --frozen --no-dev --no-sync uvicorn api.main:app --host \"$HOST\" --port \"$PORT\" --proxy-headers --timeout-graceful-shutdown 20",
        "preStartCommands": [
          "uv run --frozen --no-dev --no-sync python -m cli pre-start"
        ]
      }
    },
    {
      "type": "app",
      "name": "web",
      "path": "apps/web",
      "routes": [
        {
          "path": "/"
        }
      ],
      "port": 3001,
      "serve": "static",
      "runtime": "node",
      "build": {
        "context": ".",
        "dockerfile": "deploy/docker/Dockerfile.web",
        "target": "runtime"
      },
      "dev": {
        "startCommand": "bun run dev"
      },
      "deploy": {
        "startCommand": "node .output/server/index.mjs"
      }
    },
    {
      "type": "managed",
      "name": "postgres",
      "engine": "postgres"
    }
  ]
}
